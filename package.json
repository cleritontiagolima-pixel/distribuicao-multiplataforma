{
  "name": "ctube",
  "version": "1.1.0",
  "description": "CTUBE - Player de vídeo multiplataforma",
  "author": "CTUBE",
  "private": true,
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.ctube.desktop",
    "productName": "CTUBE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "public/**/*",
      "!desktop/*.map"
    ],
    "extraResources": [
      {
        "from": ".next/server/app",
        "to": "static/.next/server/app"
      },
      {
        "from": ".next/static",
        "to": "static/.next/static"
      },
      {
        "from": "public",
        "to": "static/public"
      }
    ],
    "asar": false,
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "electron desktop/main.cjs",
    "desktop:build": "pnpm build && electron-builder",
    "mobile:shell": "node scripts/prepare-mobile-shell.mjs",
    "mobile:sync": "pnpm mobile:shell && npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "build:installers": "echo 'Installers are built by GitHub Actions. Push a v* tag to trigger.' && echo '  git tag v1.0.0 && git push origin v1.0.0'",
    "build:desktop": "pnpm build && npx electron-builder --publish never",
    "build:desktop:win": "pnpm build && npx electron-builder --win --publish never",
    "build:desktop:mac": "pnpm build && npx electron-builder --mac --publish never",
    "build:desktop:linux": "pnpm build && npx electron-builder --linux --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
